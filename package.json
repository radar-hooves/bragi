{
  "name": "bragi",
  "version": "2026.11.1",
  "description": "The desktop player for your own Jellyfin or OpenSubsonic music server, browsable even offline",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.css\"",
    "lint:drift": "node scripts/check-ui-drift.mjs",
    "lint:design": "node scripts/check-design-craft.mjs",
    "lint:design:live": "node scripts/check-design-craft.mjs --live",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@poodle64/design-tokens": "^2026.10.2",
    "@poodle64/ui": "2026.11.12",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.72.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "impeccable": "4.8.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "comment": "Security overrides for transitive dev/build deps (all patched within their compatible major — a bare >= would jump majors, e.g. cookie 2.x drops the `parse` export SvelteKit needs).",
    "overrides": {
      "postcss@<8.5.18": "^8.5.18",
      "devalue@<5.9.3": "^5.9.3",
      "fast-uri@<3.1.6": "^3.1.6",
      "cookie@<0.7.0": "^0.7.0",
      "js-yaml@<4.3.1": "^4.3.1",
      "nanoid@<3.3.17": "^3.3.17"
    }
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
