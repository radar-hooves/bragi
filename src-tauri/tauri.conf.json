{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bragi",
  "version": "2026.11.1",
  "identifier": "com.poodle64.bragi",
  "build": {
    "runner": "../scripts/cargo-codesign.sh",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "bash scripts/cargo-codesign.sh check-bundle",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bragi",
        "width": 1920,
        "height": 1080,
        "minWidth": 520,
        "minHeight": 400,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*; img-src 'self' artwork: http://artwork.localhost https://* data:; media-src 'self' https://*"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2Q0Q5QzU1OUYzMEExMDQKUldRRW9UQ2ZWWnpOQmsrVDNFZHE2VW4zU2FWa1ZkWjV2ODBlWHpVSTM4VlppK05Pc2l3NG5pOUQK",
      "endpoints": ["https://github.com/radar-hooves/bragi/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["mpv", "libayatana-appindicator3-1 | libappindicator3-1"]
      }
    }
  }
}
